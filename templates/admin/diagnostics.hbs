<main class="container-xl">
    <div id="diagnostics-block" class="my-3 p-3 rounded shadow">
        <h6 class="border-bottom pb-2 mb-2">诊断</h6>

        <h3>版本信息</h3>
        <div class="row">
            <div class="col-md">
                <dl class="row">
                    <dt class="col-sm-5">服务器已安装
                        <span class="badge bg-success d-none abbr-badge" id="server-success" title="已安装最新版本。">正常</span>
                        <span class="badge bg-warning text-dark d-none abbr-badge" id="server-warning" title="有更新可用。">更新</span>
                        <span class="badge bg-info text-dark d-none abbr-badge" id="server-branch" title="这是一个分支版本。">分支</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="server-installed">{{page_data.current_release}}</span>
                    </dd>
                    <dt class="col-sm-5">服务器最新版
                        <span class="badge bg-secondary d-none abbr-badge" id="server-failed" title="无法确定最新版本。">未知</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="server-latest">{{page_data.latest_release}}<span id="server-latest-commit" class="d-none">-{{page_data.latest_commit}}</span></span>
                    </dd>
                    {{#if page_data.web_vault_enabled}}
                    <dt class="col-sm-5">网页已安装
                        <span class="badge bg-success d-none abbr-badge" id="web-success" title="已安装最新版本。">正常</span>
                        <span class="badge bg-warning text-dark d-none abbr-badge" id="web-warning" title="有更新可用。">更新</span>
                        <span class="badge bg-info text-dark d-none abbr-badge" id="web-prerelease" title="您正在使用预发布版本。">预发布</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="web-installed">{{page_data.active_web_release}}</span>
                    </dd>
                    <dt class="col-sm-5">网页最新版
                        <span class="badge bg-secondary d-none abbr-badge" id="web-failed" title="无法确定最新版本。">未知</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="web-latest">{{page_data.latest_web_release}}</span>
                    </dd>
                    {{/if}}
                    {{#unless page_data.web_vault_enabled}}
                    <dt class="col-sm-5">网页已安装</dt>
                    <dd class="col-sm-7">
                        <span id="web-installed">网页保险库已禁用</span>
                    </dd>
                    {{/unless}}
                    <dt class="col-sm-5">数据库</dt>
                    <dd class="col-sm-7">
                        <span><b>{{page_data.db_type}}:</b> {{page_data.db_version}}</span>
                    </dd>
                </dl>
            </div>
        </div>

        <h3>检查项</h3>
        <div class="row">
            <div class="col-md">
                <dl class="row">
                    <dt class="col-sm-5">操作系统/架构</dt>
                    <dd class="col-sm-7">
                        <span class="d-block"><b>{{ page_data.host_os }} / {{ page_data.host_arch }}</b></span>
                    </dd>
                    <dt class="col-sm-5">在容器中运行</dt>
                    <dd class="col-sm-7">
                    {{#if page_data.running_within_container}}
                        <span class="d-block"><b>是（基础镜像：{{ page_data.container_base_image }}）</b></span>
                    {{/if}}
                    {{#unless page_data.running_within_container}}
                        <span class="d-block"><b>否</b></span>
                    {{/unless}}
                    </dd>
                    <dt class="col-sm-5">使用 config.json</dt>
                    <dd class="col-sm-7">
                    {{#if page_data.overrides}}
                        <span class="d-inline"><b>是</b></span>
                        <span class="badge bg-info text-dark abbr-badge" title="环境变量被 config.json 覆盖。&#013;&#010;{{page_data.overrides}}">详情</span>
                    {{/if}}
                    {{#unless page_data.overrides}}
                        <span class="d-block"><b>否</b></span>
                    {{/unless}}
                    </dd>
                    <dt class="col-sm-5">使用反向代理</dt>
                    <dd class="col-sm-7">
                    {{#if page_data.ip_header_exists}}
                        <span class="d-block" title="找到IP头。"><b>是</b></span>
                    {{/if}}
                    {{#unless page_data.ip_header_exists}}
                        <span class="d-block" title="未找到IP头。"><b>否</b></span>
                    {{/unless}}
                    </dd>
                    {{!-- Only show this if the IP Header Exists --}}
                    {{#if page_data.ip_header_exists}}
                    <dt class="col-sm-5">IP头
                    {{#if page_data.ip_header_match}}
                        <span class="badge bg-success abbr-badge" title="IP_HEADER 配置似乎有效。">匹配</span>
                    {{/if}}
                    {{#unless page_data.ip_header_match}}
                        <span class="badge bg-danger abbr-badge" title="IP_HEADER 配置似乎无效。日志中的IP可能无效。请修复。">不匹配</span>
                    {{/unless}}
                    </dt>
                    <dd class="col-sm-7">
                    {{#if page_data.ip_header_match}}
                        <span class="d-block"><b>配置/服务器：</b> {{ page_data.ip_header_name }}</span>
                    {{/if}}
                    {{#unless page_data.ip_header_match}}
                        <span class="d-block"><b>配置：</b> {{ page_data.ip_header_config }}</span>
                        <span class="d-block"><b>服务器：</b> {{ page_data.ip_header_name }}</span>
                    {{/unless}}
                    </dd>
                    {{/if}}
                    {{!-- End if IP Header Exists --}}
                    <dt class="col-sm-5">网络访问
                    {{#if page_data.has_http_access}}
                        <span class="badge bg-success abbr-badge" title="我们有网络访问权限！">正常</span>
                    {{/if}}
                    {{#unless page_data.has_http_access}}
                        <span class="badge bg-danger abbr-badge" title="似乎没有网络访问权限。请修复。">错误</span>
                    {{/unless}}
                    </dt>
                    <dd class="col-sm-7">
                    {{#if page_data.has_http_access}}
                        <span class="d-block"><b>是</b></span>
                    {{/if}}
                    {{#unless page_data.has_http_access}}
                        <span class="d-block"><b>否</b></span>
                    {{/unless}}
                    </dd>
                    <dt class="col-sm-5">通过代理访问网络</dt>
                    <dd class="col-sm-7">
                    {{#if page_data.uses_proxy}}
                        <span class="d-block" title="网络访问通过代理进行（已配置HTTPS_PROXY或HTTP_PROXY）。"><b>是</b></span>
                    {{/if}}
                    {{#unless page_data.uses_proxy}}
                        <span class="d-block" title="我们有直接的网络访问权限，未配置出站代理。"><b>否</b></span>
                    {{/unless}}
                    </dd>
                    <dt class="col-sm-5">WebSocket启用
                        {{#if page_data.enable_websocket}}
                        <span class="badge bg-success d-none abbr-badge" id="websocket-success" title="WebSocket连接正常工作。">正常</span>
                        <span class="badge bg-danger d-none abbr-badge" id="websocket-error" title="WebSocket连接错误，请验证您的反向代理配置！">错误</span>
                        {{/if}}
                    </dt>
                    <dd class="col-sm-7">
                    {{#if page_data.enable_websocket}}
                        <span class="d-block" title="WebSocket连接已启用（ENABLE_WEBSOCKET为true）。"><b>是</b></span>
                    {{/if}}
                    {{#unless page_data.enable_websocket}}
                        <span class="d-block" title="WebSocket连接已禁用（ENABLE_WEBSOCKET为false）。"><b>否</b></span>
                    {{/unless}}
                    </dd>

                    <dt class="col-sm-5">DNS解析（github.com）
                        <span class="badge bg-success d-none abbr-badge" id="dns-success" title="DNS解析正常！">正常</span>
                        <span class="badge bg-danger d-none abbr-badge" id="dns-warning" title="DNS解析失败。请修复。">错误</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="dns-resolved">{{page_data.dns_resolved}}</span>
                    </dd>
                    <dt class="col-sm-5">日期和时间（本地）
                        {{#if page_data.tz_env}}
                            <span class="badge bg-success abbr-badge" title="已配置TZ环境变量">{{page_data.tz_env}}</span>
                        {{/if}}
                    </dt>
                    <dd class="col-sm-7">
                        <span><b>服务器：</b> {{page_data.server_time_local}}</span>
                    </dd>
                    <dt class="col-sm-5">日期和时间（UTC）
                        <span class="badge bg-success d-none abbr-badge" id="time-success" title="服务器和浏览器时间相差在15秒以内。">服务器/浏览器正常</span>
                        <span class="badge bg-danger d-none abbr-badge" id="time-warning" title="服务器和浏览器时间相差超过15秒。">服务器/浏览器错误</span>
                        <span class="badge bg-success d-none abbr-badge" id="ntp-server-success" title="服务器和NTP时间相差在15秒以内。">服务器NTP正常</span>
                        <span class="badge bg-danger d-none abbr-badge" id="ntp-server-warning" title="服务器和NTP时间相差超过15秒。">服务器NTP错误</span>
                        <span class="badge bg-success d-none abbr-badge" id="ntp-browser-success" title="浏览器和NTP时间相差在15秒以内。">浏览器NTP正常</span>
                        <span class="badge bg-danger d-none abbr-badge" id="ntp-browser-warning" title="浏览器和NTP时间相差超过15秒。">浏览器NTP错误</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="ntp-time" class="d-block"><b>NTP：</b> <span id="ntp-server-string">{{page_data.ntp_time}}</span></span>
                        <span id="time-server" class="d-block"><b>服务器：</b> <span id="time-server-string">{{page_data.server_time}}</span></span>
                        <span id="time-browser" class="d-block"><b>浏览器：</b> <span id="time-browser-string"></span></span>
                    </dd>

                    <dt class="col-sm-5">域名配置
                        <span class="badge bg-success d-none abbr-badge" id="domain-success" title="域名变量与浏览器位置匹配，似乎配置正确。">匹配</span>
                        <span class="badge bg-danger d-none abbr-badge" id="domain-warning" title="域名变量与浏览器位置不匹配。&#013;&#010;域名变量似乎配置不正确。&#013;&#010;某些功能可能无法正常工作！">不匹配</span>
                        <span class="badge bg-success d-none abbr-badge" id="https-success" title="配置为使用HTTPS">HTTPS</span>
                        <span class="badge bg-danger d-none abbr-badge" id="https-warning" title="未配置为使用HTTPS。&#013;&#010;某些功能可能无法正常工作！">无HTTPS</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="domain-server" class="d-block"><b>服务器：</b> <span id="domain-server-string">{{page_data.admin_url}}</span></span>
                        <span id="domain-browser" class="d-block"><b>浏览器：</b> <span id="domain-browser-string"></span></span>
                    </dd>

                    <dt class="col-sm-5">HTTP响应验证
                        <span class="badge bg-success d-none abbr-badge" id="http-response-success" title="所有头部和HTTP请求响应似乎都正常。">正常</span>
                        <span class="badge bg-danger d-none abbr-badge" id="http-response-warning" title="某些头部或HTTP请求响应返回无效数据！">错误</span>
                    </dt>
                    <dd class="col-sm-7">
                        <span id="http-response-errors" class="d-block"></span>
                    </dd>
                </dl>
            </div>
        </div>

        <h3>支持</h3>
        <div class="row">
            <div class="col-md">
                <dl class="row">
                    <dd class="col-sm-12">
                        如果您需要支持，请先检查以下链接，然后再创建新问题：
                         <a href="https://vaultwarden.discourse.group/" target="_blank" rel="noreferrer noopener">Vaultwarden论坛</a>
                         | <a href="https://github.com/dani-garcia/vaultwarden/discussions" target="_blank" rel="noreferrer noopener">GitHub讨论</a>
                    </dd>
                </dl>
                <dl class="row">
                    <dd class="col-sm-12">
                        您可以使用下面的按钮预生成一个字符串，您可以将其复制/粘贴到论坛或在GitHub上创建新问题时使用。<br>
                        我们默认尝试隐藏生成的支持字符串中最敏感的值，但请验证其中是否包含您想要隐藏的内容！<br>
                    </dd>
                </dl>
                <dl class="row">
                    <dt class="col-sm-3">
                        <button type="button" id="gen-support" class="btn btn-primary">生成支持字符串</button>
                        <br><br>
                        <button type="button" id="copy-support" class="btn btn-info mb-3 d-none">复制到剪贴板</button>
                        <div class="toast-container position-absolute float-start vw-copy-toast">
                            <div id="toastClipboardCopy" class="toast fade hide" role="status" aria-live="polite" aria-atomic="true" data-bs-autohide="true" data-bs-delay="1500">
                                <div class="toast-body">
                                    已复制到剪贴板！
                                </div>
                            </div>
                        </div>
                    </dt>
                    <dd class="col-sm-9">
                        <pre id="support-string" class="pre-scrollable d-none w-100 border p-2"></pre>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</main>
<script src="{{urlpath}}/vw_static/admin_diagnostics.js"></script>
<script type="application/json" id="diagnostics_json">{{to_json page_data}}</script>